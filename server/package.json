{
  "name": "@backupviiz/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean --noExternal @backupviiz/shared",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backupviiz/shared": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@simplewebauthn/server": "^13.1.1",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": { "@types/node": "^22.10.0", "tsup": "^8.3.5", "tsx": "^4.19.2", "vitest": "^2.1.8" }
}
